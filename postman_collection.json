      "name": "11 Achievements",
      "item": [
        { "name": "Catálogo", "request": { "method": "GET", "header": [{"key":"Authorization","value":"Bearer {{token}}"}], "url": {"raw": "{{base_url}}/achievements/"} } },
        { "name": "Mis Logros", "request": { "method": "GET", "header": [{"key":"Authorization","value":"Bearer {{token}}"}], "url": {"raw": "{{base_url}}/my-achievements/"} } }
      ]
    },
    {
      "name": "12 Classrooms",
      "item": [
        { "name": "Listar (Teacher)", "request": { "method": "GET", "header": [{"key":"Authorization","value":"Bearer {{token}}"}], "url": {"raw": "{{base_url}}/classrooms/"} } },
        { "name": "Crear Clase", "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{token}}"}], "url": {"raw": "{{base_url}}/classrooms/"}, "body": {"mode": "raw", "raw": "{\"name\":\"Inglés A1 - Tarde\",\"description\":\"Lunes y miércoles\",\"course\":1}"} } },
        { "name": "Detalle (con alumnos)", "request": { "method": "GET", "header": [{"key":"Authorization","value":"Bearer {{token}}"}], "url": {"raw": "{{base_url}}/classrooms/1/"} } },
        { "name": "Unirse (Student)", "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{token}}"}], "url": {"raw": "{{base_url}}/classrooms/join/"}, "body": {"mode": "raw", "raw": "{\"access_code\":\"A3FX9K2T\"}"} } },
        { "name": "Mis Clases (Student)", "request": { "method": "GET", "header": [{"key":"Authorization","value":"Bearer {{token}}"}], "url": {"raw": "{{base_url}}/classrooms/mine/"} } },
        { "name": "Expulsar Alumno", "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{token}}"}], "url": {"raw": "{{base_url}}/classrooms/1/remove-student/"}, "body": {"mode": "raw", "raw": "{\"student_id\":3}"} } }
      ]
    },
    {
      "name": "13 Resources",
      "item": [
        { "name": "Listar", "request": { "method": "GET", "header": [{"key":"Authorization","value":"Bearer {{token}}"}], "url": {"raw": "{{base_url}}/resources/"} } },
        { "name": "Filtrar por tipo", "request": { "method": "GET", "header": [{"key":"Authorization","value":"Bearer {{token}}"}], "url": {"raw": "{{base_url}}/resources/?resource_type=pdf&course=1"} } },
        { "name": "Crear PDF", "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{token}}"}], "url": {"raw": "{{base_url}}/resources/"}, "body": {"mode": "raw", "raw": "{\"title\":\"Gramática A1\",\"description\":\"PDF completo\",\"resource_type\":\"pdf\",\"file_url\":\"https://drive.google.com/file/d/abc/view\",\"course\":1,\"lesson\":null,\"is_public\":true}"} } },
        { "name": "Crear Video", "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{token}}"}], "url": {"raw": "{{base_url}}/resources/"}, "body": {"mode": "raw", "raw": "{\"title\":\"Clase grabada\",\"description\":\"Video del lunes\",\"resource_type\":\"video\",\"file_url\":\"https://youtube.com/watch?v=abc\",\"course\":1,\"lesson\":null,\"is_public\":true}"} } },
