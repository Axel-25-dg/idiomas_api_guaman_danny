        { "name": "Crear", "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{token}}"}], "url": {"raw": "{{base_url}}/certificates/"}, "body": {"mode": "raw", "raw": "{\"student\":3,\"level\":\"A1\",\"title\":\"Certificado Inglés A1 - JumpUp UTE\",\"description\":\"Aprobó nivel A1\",\"status\":\"pending\"}"} } },
        { "name": "Emitir", "request": { "method": "PATCH", "header": [{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{token}}"}], "url": {"raw": "{{base_url}}/certificates/1/issue/"}, "body": {"mode": "raw", "raw": "{}"} } },
