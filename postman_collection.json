{
  "info": {
    "name": "JumpUp UTE - API Completa v2",
    "description": "Colección actualizada con todos los endpoints del backend.\n\n1. Ejecuta Login\n2. Copia access token\n3. Pégalo en la variable {{token}}",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "https://guaman-idiomas-ute.online/api" },
    { "key": "token", "value": "" },
    { "key": "refresh_token", "value": "" }
  ],
  "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
  "item": [
    {
      "name": "01 Auth",
      "item": [
        { "name": "Register", "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"}], "url": {"raw": "{{base_url}}/auth/register/"}, "body": {"mode": "raw", "raw": "{\"username\":\"testuser\",\"email\":\"test@email.com\",\"password\":\"TestPass123!\",\"password2\":\"TestPass123!\"}"} } },
        { "name": "Login", "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"}], "url": {"raw": "{{base_url}}/auth/login/"}, "body": {"mode": "raw", "raw": "{\"email\":\"test@email.com\",\"password\":\"TestPass123!\"}"} } },
        { "name": "Refresh Token", "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"}], "url": {"raw": "{{base_url}}/auth/token/refresh/"}, "body": {"mode": "raw", "raw": "{\"refresh\":\"{{refresh_token}}\"}"} } },
        { "name": "Me", "request": { "method": "GET", "header": [{"key":"Authorization","value":"Bearer {{token}}"}], "url": {"raw": "{{base_url}}/auth/me/"} } }
      ]
    },
    {
      "name": "02 Dashboard",
      "item": [
        { "name": "Dashboard Student", "request": { "method": "GET", "header": [{"key":"Authorization","value":"Bearer {{token}}"}], "url": {"raw": "{{base_url}}/dashboard/student/"} } },
        { "name": "Dashboard Teacher", "request": { "method": "GET", "header": [{"key":"Authorization","value":"Bearer {{token}}"}], "url": {"raw": "{{base_url}}/dashboard/teacher/"} } },
        { "name": "Dashboard Admin", "request": { "method": "GET", "header": [{"key":"Authorization","value":"Bearer {{token}}"}], "url": {"raw": "{{base_url}}/dashboard/admin/"} } }
      ]
    },
    {
      "name": "03 Users (Admin)",
      "item": [
        { "name": "Listar Staff", "request": { "method": "GET", "header": [{"key":"Authorization","value":"Bearer {{token}}"}], "url": {"raw": "{{base_url}}/users/"} } },
        { "name": "Crear Teacher", "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{token}}"}], "url": {"raw": "{{base_url}}/users/"}, "body": {"mode": "raw", "raw": "{\"username\":\"profe1\",\"email\":\"profe1@email.com\",\"first_name\":\"Carlos\",\"last_name\":\"García\",\"password\":\"ProfePass123!\",\"role_id\":2}"} } },
        { "name": "Listar Estudiantes", "request": { "method": "GET", "header": [{"key":"Authorization","value":"Bearer {{token}}"}], "url": {"raw": "{{base_url}}/admin-students/"} } },
        { "name": "Actualizar Usuario", "request": { "method": "PATCH", "header": [{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{token}}"}], "url": {"raw": "{{base_url}}/users/1/"}, "body": {"mode": "raw", "raw": "{\"first_name\":\"Actualizado\"}"} } },
        { "name": "Eliminar Usuario", "request": { "method": "DELETE", "header": [{"key":"Authorization","value":"Bearer {{token}}"}], "url": {"raw": "{{base_url}}/users/1/"} } }
      ]
    },
    {
      "name": "04 Languages",
      "item": [
        { "name": "Listar", "request": { "method": "GET", "header": [{"key":"Authorization","value":"Bearer {{token}}"}], "url": {"raw": "{{base_url}}/languages/"} } },
        { "name": "Crear (Admin)", "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{token}}"}], "url": {"raw": "{{base_url}}/languages/"}, "body": {"mode": "raw", "raw": "{\"name\":\"Inglés\",\"code\":\"EN\",\"flag_icon_url\":\"https://flagcdn.com/w80/gb.png\"}"} } },
        { "name": "Detalle", "request": { "method": "GET", "header": [{"key":"Authorization","value":"Bearer {{token}}"}], "url": {"raw": "{{base_url}}/languages/1/"} } },
        { "name": "Actualizar", "request": { "method": "PUT", "header": [{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{token}}"}], "url": {"raw": "{{base_url}}/languages/1/"}, "body": {"mode": "raw", "raw": "{\"name\":\"Inglés\",\"code\":\"EN\",\"flag_icon_url\":\"https://flagcdn.com/w80/gb.png\"}"} } },
        { "name": "Eliminar", "request": { "method": "DELETE", "header": [{"key":"Authorization","value":"Bearer {{token}}"}], "url": {"raw": "{{base_url}}/languages/1/"} } }
      ]
    },
    {
      "name": "05 Courses",
      "item": [
        { "name": "Listar", "request": { "method": "GET", "header": [{"key":"Authorization","value":"Bearer {{token}}"}], "url": {"raw": "{{base_url}}/courses/"} } },
        { "name": "Buscar", "request": { "method": "GET", "header": [{"key":"Authorization","value":"Bearer {{token}}"}], "url": {"raw": "{{base_url}}/courses/?search=inglés&ordering=title"} } },
        { "name": "Filtrar", "request": { "method": "GET", "header": [{"key":"Authorization","value":"Bearer {{token}}"}], "url": {"raw": "{{base_url}}/courses/?language=1&difficulty_level=A1"} } },
        { "name": "Crear", "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{token}}"}], "url": {"raw": "{{base_url}}/courses/"}, "body": {"mode": "raw", "raw": "{\"language\":1,\"title\":\"Inglés Básico A1\",\"description\":\"Curso completo\",\"difficulty_level\":\"A1\"}"} } },
        { "name": "Detalle", "request": { "method": "GET", "header": [{"key":"Authorization","value":"Bearer {{token}}"}], "url": {"raw": "{{base_url}}/courses/1/"} } },
        { "name": "Eliminar", "request": { "method": "DELETE", "header": [{"key":"Authorization","value":"Bearer {{token}}"}], "url": {"raw": "{{base_url}}/courses/1/"} } }
      ]
    },
    {
      "name": "06 Modules",
      "item": [
        { "name": "Listar por curso", "request": { "method": "GET", "header": [{"key":"Authorization","value":"Bearer {{token}}"}], "url": {"raw": "{{base_url}}/modules/?course=1"} } },
        { "name": "Crear", "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{token}}"}], "url": {"raw": "{{base_url}}/modules/"}, "body": {"mode": "raw", "raw": "{\"course\":1,\"title\":\"Saludos y presentaciones\",\"order\":1}"} } }
      ]
    },
    {
      "name": "07 Lessons",
      "item": [
        { "name": "Listar por módulo", "request": { "method": "GET", "header": [{"key":"Authorization","value":"Bearer {{token}}"}], "url": {"raw": "{{base_url}}/lessons/?module=1"} } },
        { "name": "Crear Lección", "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{token}}"}], "url": {"raw": "{{base_url}}/lessons/"}, "body": {"mode": "raw", "raw": "{\"module\":1,\"title\":\"Hello & Goodbye\",\"content_type\":\"text\",\"order\":1,\"xp_reward\":15}"} } },
        { "name": "Crear Examen", "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{token}}"}], "url": {"raw": "{{base_url}}/lessons/"}, "body": {"mode": "raw", "raw": "{\"module\":1,\"title\":\"Examen Final\",\"content_type\":\"interactive\",\"order\":10,\"xp_reward\":100}"} } },
        { "name": "Stats de Lección", "request": { "method": "GET", "header": [{"key":"Authorization","value":"Bearer {{token}}"}], "url": {"raw": "{{base_url}}/lessons/1/stats/"} } }
      ]
    },
    {
      "name": "08 Exercises",
      "item": [
        { "name": "Listar por lección", "request": { "method": "GET", "header": [{"key":"Authorization","value":"Bearer {{token}}"}], "url": {"raw": "{{base_url}}/exercises/?lesson=1"} } },
        { "name": "Crear - Opción múltiple", "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{token}}"}], "url": {"raw": "{{base_url}}/exercises/"}, "body": {"mode": "raw", "raw": "{\"lesson\":1,\"question_text\":\"¿Cómo se dice Hola?\",\"exercise_type\":\"multiple_choice\",\"correct_answer\":\"Hello\"}"} } },
        { "name": "Crear - Traducir", "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{token}}"}], "url": {"raw": "{{base_url}}/exercises/"}, "body": {"mode": "raw", "raw": "{\"lesson\":1,\"question_text\":\"Traduce: Good morning\",\"exercise_type\":\"translate\",\"correct_answer\":\"Buenos días\"}"} } },
        { "name": "Crear - Completar", "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{token}}"}], "url": {"raw": "{{base_url}}/exercises/"}, "body": {"mode": "raw", "raw": "{\"lesson\":1,\"question_text\":\"She ___ a teacher\",\"exercise_type\":\"fill_blank\",\"correct_answer\":\"is\"}"} } },
        { "name": "Crear - Escuchar", "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{token}}"}], "url": {"raw": "{{base_url}}/exercises/"}, "body": {"mode": "raw", "raw": "{\"lesson\":1,\"question_text\":\"Escucha y escribe\",\"exercise_type\":\"listen\",\"correct_answer\":\"Goodbye\"}"} } },
        { "name": "Crear - Emparejar", "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{token}}"}], "url": {"raw": "{{base_url}}/exercises/"}, "body": {"mode": "raw", "raw": "{\"lesson\":1,\"question_text\":\"Cat = ?\",\"exercise_type\":\"match\",\"correct_answer\":\"Gato\"}"} } }
      ]
    },
    {
      "name": "09 Progress",
      "item": [
        { "name": "Mi Progreso", "request": { "method": "GET", "header": [{"key":"Authorization","value":"Bearer {{token}}"}], "url": {"raw": "{{base_url}}/progress/"} } },
        { "name": "Completados", "request": { "method": "GET", "header": [{"key":"Authorization","value":"Bearer {{token}}"}], "url": {"raw": "{{base_url}}/progress/?status=completed"} } },
        { "name": "Resumen", "request": { "method": "GET", "header": [{"key":"Authorization","value":"Bearer {{token}}"}], "url": {"raw": "{{base_url}}/progress/summary/"} } },
        { "name": "Registrar (completar lección)", "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{token}}"}], "url": {"raw": "{{base_url}}/progress/"}, "body": {"mode": "raw", "raw": "{\"lesson\":1,\"status\":\"completed\",\"score\":90}"} } }
      ]
    },
    {
      "name": "10 Stats + Ranking",
      "item": [
        { "name": "Mis Stats", "request": { "method": "GET", "header": [{"key":"Authorization","value":"Bearer {{token}}"}], "url": {"raw": "{{base_url}}/stats/"} } },
        { "name": "Ranking Top 100", "request": { "method": "GET", "header": [{"key":"Authorization","value":"Bearer {{token}}"}], "url": {"raw": "{{base_url}}/ranking/"} } }
